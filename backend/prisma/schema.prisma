// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  FULL_TIME
  PART_TIME
  KELUAR
}

enum Actions {
  CREATE
  UPDATE
  DELETE
}

model Employee {
  id            Int            @id @default(autoincrement())
  nama          String
  email         String         @unique
  no_telp       String
  jabatan       String
  status        EmployeeStatus @default(PART_TIME)
  tanggal_masuk DateTime       @db.Date
  image         String?
  department_id Int
  department    Department     @relation(fields: [department_id], references: [id])

  @@index([department_id])
  @@map("employee")
}

model Department {
  id        Int        @id @default(autoincrement())
  nama      String     @unique
  deskripsi String?
  employees Employee[]

  @@map("departments")
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  password  String
  auditLogs AuditLog[]

  @@map("user")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  target    String
  target_id String
  action    Actions
  changes   String
  user_id   Int?
  username  String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([target, target_id])
  @@index([user_id])
  @@index([createdAt])
}
